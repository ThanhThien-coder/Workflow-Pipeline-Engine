# Cấu hình dịch vụ WPE AI Microservice
HOST=0.0.0.0
PORT=8081
APP_RELOAD=false

# Khóa nội bộ xác thực request từ Spring Boot Backend (Header: X-Internal-Key)
# Để trống ở môi trường dev cục bộ nếu chưa cấu hình phía Java
AI_INTERNAL_KEY=

# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Model chính, rồi model dự phòng (cách nhau dấu phẩy) khi model chính quá tải/lỗi
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Mỗi model đứng trước model cuối tối đa 12 giây; cả chuỗi tối đa 25 giây (backend chờ 30 giây)
GEMINI_TIMEOUT_MS=12000
GEMINI_TOTAL_TIMEOUT_MS=25000
# Gemini 3 trở đi dùng THINKING_LEVEL; Gemini 2.5 dùng THINKING_BUDGET
GEMINI_THINKING_LEVEL=LOW
GEMINI_THINKING_BUDGET=256
