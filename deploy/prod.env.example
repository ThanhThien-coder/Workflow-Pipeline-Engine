# Sao chép thành deploy/.env (git đã bỏ qua file này) rồi điền giá trị. Các biến bí mật để trống thì docker compose sẽ báo lỗi và không chạy.

# Cổng HTTP công khai của Nginx trên máy chủ
WEB_PORT=80

# Tên cơ sở dữ liệu PostgreSQL
POSTGRES_DB=wpe_db

# Tên người dùng cơ sở dữ liệu PostgreSQL
POSTGRES_USER=wpe_user

# Mật khẩu cơ sở dữ liệu PostgreSQL (bắt buộc)
POSTGRES_PASSWORD=

# Tên người dùng RabbitMQ
RABBITMQ_USERNAME=wpe_rabbit

# Mật khẩu RabbitMQ (bắt buộc)
RABBITMQ_PASSWORD=

# ít nhất 32 byte, sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# backend và AI service dùng chung; sinh giống JWT_SECRET
AI_INTERNAL_KEY=

# để trống thì AI dùng phân tích dự phòng (không gọi Gemini)
GEMINI_API_KEY=

# Model Gemini sử dụng
GEMINI_MODEL=gemini-2.5-flash

# để trống vì frontend và API cùng nguồn qua nginx
APP_CORS_ALLOWED_ORIGINS=
