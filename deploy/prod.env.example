# Sao chép thành deploy/.env (git đã bỏ qua file này) rồi điền giá trị. Các biến bí mật để trống thì docker compose sẽ báo lỗi và không chạy.

# Cổng HTTP công khai của Nginx trên máy chủ (chỉ dùng khi KHÔNG bật HTTPS bằng Caddy)
WEB_PORT=80

# HTTPS tự động bằng Caddy (deploy/docker-compose.https.yml): tên miền đã trỏ về IP máy chủ, ví dụ wpe.example.com.
# Khi bật HTTPS thì đặt APP_PUBLIC_URL=https://<tên miền>. Cổng 80/443 phải mở ra Internet để Let's Encrypt cấp chứng chỉ.
SITE_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443

# Tên cơ sở dữ liệu PostgreSQL
POSTGRES_DB=wpe_db

# Tên người dùng cơ sở dữ liệu PostgreSQL
POSTGRES_USER=wpe_user

# Mật khẩu cơ sở dữ liệu PostgreSQL (bắt buộc)
POSTGRES_PASSWORD=

# Tên người dùng RabbitMQ
RABBITMQ_USERNAME=wpe_rabbit

# Mật khẩu RabbitMQ (bắt buộc)
RABBITMQ_PASSWORD=

# ít nhất 32 byte, sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# backend và AI service dùng chung; sinh giống JWT_SECRET
AI_INTERNAL_KEY=

# Mật khẩu riêng cho 3 tài khoản mẫu (admin, alex.kim, sarah.chen) thay cho mật khẩu công khai trong README.
# Bắt buộc khi các tài khoản này còn mật khẩu mẫu: ít nhất 12 ký tự, có chữ số. Thiếu thì backend không khởi động.
# Lần chạy đầu backend tự đổi sang mật khẩu này; sau đó nên đăng nhập và đổi riêng từng tài khoản trong Profile.
SEED_ACCOUNT_PASSWORD=

# Cong cu demo (ep trang thai task, gia lap qua han...) cho buoi bao ve/test. Mac dinh false; chi doi true khi demo roi tat lai.
DEMO_TOOLS_ENABLED=false

# để trống thì AI dùng phân tích dự phòng (không gọi Gemini)
GEMINI_API_KEY=

# Model Gemini chính và model dự phòng (gemini-2.5-flash không còn mở cho key mới)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# mỗi model trước model cuối tối đa 12 giây, cả chuỗi tối đa 25 giây (backend chờ 30 giây)
GEMINI_TIMEOUT_MS=12000
GEMINI_TOTAL_TIMEOUT_MS=25000

# để trống vì frontend và API cùng nguồn qua nginx
APP_CORS_ALLOWED_ORIGINS=

# Địa chỉ công khai của trang web (dùng tạo link chia sẻ cho khách và link đặt lại mật khẩu trong email), ví dụ https://wpe.example.com
APP_PUBLIC_URL=http://localhost

# Gửi email quên mật khẩu / xác nhận đổi mật khẩu qua SMTP. Để trống MAIL_HOST hoặc MAIL_FROM = tắt tính năng
# (trang đăng nhập sẽ báo liên hệ quản trị viên). Ví dụ Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=<địa chỉ gmail>, MAIL_PASSWORD=<App Password 16 ký tự của Google, KHÔNG dùng mật khẩu đăng nhập>.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=

# Mật khẩu/khóa SMTP (bí mật)
MAIL_PASSWORD=

# SMTP có xác thực và STARTTLS (để true với nhà cung cấp thật)
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Địa chỉ người gửi hiển thị trong email
MAIL_FROM=
MAIL_FROM_NAME=Workflow Pipeline Engine

# Link đặt lại mật khẩu hết hạn sau bao nhiêu phút
PASSWORD_RESET_TTL_MINUTES=30
