' Nguồn: wpe-backend/src/main/java/com/pipeline/wpe/common/enums/InvitationStatus.java, wpe-backend/src/main/java/com/pipeline/wpe/common/enums/FeedbackStatus.java, wpe-backend/src/main/java/com/pipeline/wpe/service/ProjectInvitationService.java, wpe-backend/src/main/java/com/pipeline/wpe/service/InvitationExpiryJob.java, wpe-backend/src/main/java/com/pipeline/wpe/service/FeedbackQueueService.java
@startuml state-loi-moi
!pragma layout smetana
skinparam shadowing false
skinparam roundcorner 4

state "Vòng đời Lời mời tham gia dự án (InvitationStatus)" as InvitationLifecycle {
  [*] --> PENDING : sendInvitation / expiresAt = now + 7 days,\nversion = 0, lưu notification, publishInvitationCreated

  PENDING --> ACCEPTED : acceptInvitation [now <= expiresAt] /\nstatus = ACCEPTED, respondedAt = now,\nkết nạp thành viên mới (Cách B),\npublishInvitationAccepted

  PENDING --> EXPIRED : InvitationExpiryJob.expireOverdueInvitations [now > expiresAt] (mỗi giờ) /\nstatus = EXPIRED, respondedAt = now

  PENDING --> EXPIRED : acceptInvitation / rejectInvitation [now > expiresAt] /\nsave(invitation [EXPIRED]), trả 409 INVITATION_EXPIRED

  PENDING --> EXPIRED : sendInvitation [lời mời cũ now > expiresAt] /\nsaveAndFlush(invitation [EXPIRED]), tạo lời mời mới

  PENDING --> REJECTED : rejectInvitation [now <= expiresAt và là người được mời] /\nstatus = REJECTED, respondedAt = now,\nđánh dấu đọc notification

  PENDING --> REVOKED : revokeInvitation [là chủ dự án/người mời/admin] /\nstatus = REVOKED, respondedAt = now

  ACCEPTED --> [*]
  EXPIRED --> [*]
  REJECTED --> [*]
  REVOKED --> [*]
}

state "Vòng đời Góp ý từ khách ngoài (FeedbackStatus)" as FeedbackLifecycle {
  [*] --> OPEN : submitGuestFeedback [token hợp lệ, dự án ACTIVE,\n<= 10 góp ý/giờ, độ dài <= 2000] /\nstatus = OPEN, publishNotification(FEEDBACK)

  OPEN --> RESOLVED : resolveFeedback [chủ dự án (OWNER) hoặc quản lý (MANAGER)] /\nstatus = RESOLVED

  RESOLVED --> [*]
}

@enduml
