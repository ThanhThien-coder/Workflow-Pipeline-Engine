' Sơ đồ Use Case mảng D - Dự án, Template, Khách & AI (WPE)

@startuml uc-du-an-noi-bo
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Người dùng" as User
actor "Thành viên dự án" as Member
actor "Chủ dự án" as Owner
actor "Quản lý" as Manager
actor "Cộng sự" as Collab
actor "Người xem" as Viewer
actor "Người được mời" as Invitee

Member --|> User
Owner --|> Member
Manager --|> Member
Collab --|> Member
Viewer --|> Member
Invitee --|> User

rectangle "WPE - Mảng Dự án (Nội bộ & Thành viên)" {
  usecase "Tạo dự án" as UC_Create
  usecase "Tạo dự án từ template" as UC_Clone
  usecase "Xem danh sách dự án" as UC_List
  usecase "Đổi trạng thái dự án" as UC_Status
  usecase "Mời thành viên" as UC_Invite
  usecase "Thu hồi lời mời" as UC_RevokeInvite
  usecase "Phản hồi lời mời" as UC_RespondInvite
  usecase "Chấp nhận lời mời" as UC_AcceptInvite
  usecase "Từ chối lời mời" as UC_RejectInvite
  usecase "Đổi vai trò thành viên" as UC_ChangeRole
  usecase "Chuyển quyền sở hữu" as UC_TransferOwner
  usecase "Xóa thành viên" as UC_RemoveMember
  usecase "Xem lịch sử thành viên" as UC_MemberHistory
  usecase "Đổi người làm và hạn chót" as UC_Assign
}

User --> UC_Create
User --> UC_List

Owner --> UC_Status
Owner --> UC_Invite
Owner --> UC_RevokeInvite
Owner --> UC_ChangeRole
Owner --> UC_RemoveMember
Owner --> UC_Assign

Manager --> UC_Assign

Member --> UC_MemberHistory

Invitee --> UC_RespondInvite

UC_Clone .> UC_Create : <<extend>> \n [người dùng chọn template]
UC_TransferOwner .> UC_ChangeRole : <<extend>> \n [vai trò mới là OWNER]

UC_AcceptInvite --|> UC_RespondInvite
UC_RejectInvite --|> UC_RespondInvite

@enduml

