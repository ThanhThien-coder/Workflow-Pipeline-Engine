  usecase "Thu hồi link khách" as UC_RevokeGuestLink
  usecase "Xem tiến độ qua link" as UC_ViewGuestProgress
  usecase "Gửi góp ý" as UC_SendFeedback
  usecase "Xem góp ý" as UC_ViewFeedback
  usecase "Đánh dấu đã xử lý góp ý" as UC_ResolveFeedback
