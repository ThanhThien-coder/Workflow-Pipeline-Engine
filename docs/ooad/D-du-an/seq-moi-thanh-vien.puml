' Nguồn: wpe-backend/src/main/java/com/pipeline/wpe/controller/ProjectInvitationController.java, wpe-backend/src/main/java/com/pipeline/wpe/service/ProjectInvitationService.java, wpe-backend/src/main/java/com/pipeline/wpe/repository/ProjectInvitationRepository.java, wpe-backend/src/main/java/com/pipeline/wpe/repository/ProjectMemberRepository.java, wpe-backend/src/main/java/com/pipeline/wpe/repository/NotificationRepository.java, wpe-backend/src/main/java/com/pipeline/wpe/service/event/WorkflowEventPublisher.java, wpe-backend/src/main/java/com/pipeline/wpe/exception/GlobalExceptionHandler.java
@startuml seq-moi-thanh-vien
autonumber
skinparam shadowing false
skinparam roundcorner 4

actor "Chủ dự án" as Owner
actor "Người được mời" as Invitee
boundary ":ProjectInvitationController" as Ctl
control ":ProjectInvitationService" as Svc
entity ":ProjectRepository" as ProjectRepo
entity ":UserRepository" as UserRepo
entity ":ProjectInvitationRepository" as InviteRepo
entity ":ProjectMemberRepository" as MemberRepo
entity ":NotificationRepository" as NotifRepo
control ":WorkflowEventPublisher" as Publisher
queue "RabbitMQ" as MQ

== 1. Chủ dự án gửi lời mời tham gia dự án ==

Owner -> Ctl : POST /api/v1/projects/{projectId}/invitations\n(CreateInvitationRequest)
activate Ctl
Ctl -> Svc : sendInvitation(projectId, request, currentUserId)
activate Svc

Svc -> ProjectRepo : findById(projectId)
activate ProjectRepo
ProjectRepo --> Svc : Optional<ProjectEntity>
deactivate ProjectRepo

alt [không phải chủ dự án: !project.getOwnerId().equals(currentUserId)]
  Svc --> Ctl : throw ForbiddenException("ACCESS_DENIED")
  Ctl --> Owner : 403 ACCESS_DENIED
else [là chủ dự án hợp lệ]
  Svc -> UserRepo : findById(currentUserId)
  activate UserRepo
  UserRepo --> Svc : Optional<UserEntity> inviter
  deactivate UserRepo

  Svc -> UserRepo : findByEmail(identifier) / findByUsername(identifier)
  activate UserRepo
  UserRepo --> Svc : Optional<UserEntity> invitee
  deactivate UserRepo

  Svc -> MemberRepo : existsByProjectIdAndUserIdAndRemovedAtIsNull(projectId, invitee.getId())
  activate MemberRepo
  MemberRepo --> Svc : boolean alreadyMember
  deactivate MemberRepo

  Svc -> InviteRepo : existsByProjectIdAndInviteeIdAndStatus(projectId, invitee.getId(), PENDING)
  activate InviteRepo
  InviteRepo --> Svc : boolean alreadyPending
  deactivate InviteRepo

  alt [đã có lời mời PENDING: alreadyPending == true]
    Svc --> Ctl : throw ConflictException("INVITATION_ALREADY_PENDING")
    Ctl --> Owner : 409 INVITATION_ALREADY_PENDING
  else [chưa có lời mời pending]
    Svc -> InviteRepo : save(invitation)
    activate InviteRepo
    InviteRepo --> Svc : savedInvitation
    deactivate InviteRepo

    Svc -> NotifRepo : save(notification)
    activate NotifRepo
    NotifRepo --> Svc : savedNotification
    deactivate NotifRepo

    Svc -> Publisher : publishInvitationCreated(invitationCreatedEvent)
    activate Publisher
    Publisher ->> MQ : publish(exchange="wpe.exchange",\nroutingKey="wpe.notification.invitation_created")
    Publisher --> Svc : void
    deactivate Publisher

    Svc --> Ctl : InvitationResponse
    Ctl --> Owner : 201 CREATED (InvitationResponse)
  end
end
deactivate Svc
deactivate Ctl

== 2. Người được mời chấp nhận lời mời ==

Invitee -> Ctl : POST /api/v1/invitations/{id}/accept
activate Ctl
Ctl -> Svc : acceptInvitation(invitationId, currentUserId)
activate Svc

Svc -> InviteRepo : findById(invitationId)
activate InviteRepo
InviteRepo --> Svc : Optional<ProjectInvitationEntity>
deactivate InviteRepo

alt [quá expires_at: invitation.getExpiresAt().isBefore(now)]
  Svc -> InviteRepo : save(invitation [status=EXPIRED])
  note over Svc, InviteRepo
    acceptInvitation (ProjectInvitationService) đặt status EXPIRED và save,
    rồi ném IllegalArgumentException trong cùng @Transactional nên transaction
    bị ROLLBACK: trạng thái EXPIRED KHÔNG được lưu vào DB (lỗi code, cần nhóm sửa).
    Mũi tên trả lời 400 BAD_REQUEST.
  end note
  activate InviteRepo
  InviteRepo --> Svc : savedInvitation
  deactivate InviteRepo
  Svc --> Ctl : throw IllegalArgumentException("Lời mời tham gia dự án đã hết hạn.")
  Ctl --> Invitee : 400 BAD_REQUEST
else [chưa quá expires_at]
  alt [đụng optimistic lock với thu hồi: version không khớp]
    Svc -> InviteRepo : save(invitation [status=ACCEPTED])
    activate InviteRepo
    InviteRepo --> Svc : throw OptimisticLockingFailureException
    deactivate InviteRepo
    Svc --> Ctl : throw OptimisticLockingFailureException
    Ctl --> Invitee : 409 OPTIMISTIC_LOCK_CONFLICT
  else [lưu thành công status=ACCEPTED]
    Svc -> InviteRepo : save(invitation [status=ACCEPTED])
    activate InviteRepo
    InviteRepo --> Svc : savedInvitation
    deactivate InviteRepo

    Svc -> MemberRepo : findByProjectIdAndUserId(projectId, currentUserId)
    activate MemberRepo
    MemberRepo --> Svc : Optional<ProjectMemberEntity> existingMemberOpt
    deactivate MemberRepo

    alt [từng bị xóa mềm: existingMemberOpt.isPresent() && removedAt != null]
      Svc -> MemberRepo : save(existingMember [removedAt=null, role, joinedAt=now])
      activate MemberRepo
      MemberRepo --> Svc : updatedMember
      deactivate MemberRepo
    else [chưa từng là thành viên: existingMemberOpt.isEmpty()]
      Svc -> MemberRepo : save(newMember)
      activate MemberRepo
      MemberRepo --> Svc : savedMember
      deactivate MemberRepo
    end

    Svc -> NotifRepo : findByUserIdAndIsReadFalseOrderByCreatedAtDesc(currentUserId)
    activate NotifRepo
    NotifRepo --> Svc : List<NotificationEntity>
    deactivate NotifRepo
    Svc -> NotifRepo : save(notification [isRead=true])
    activate NotifRepo
    NotifRepo --> Svc : savedNotification
    deactivate NotifRepo

    Svc -> ProjectRepo : findById(invitation.getProjectId())
    activate ProjectRepo
    ProjectRepo --> Svc : Optional<ProjectEntity>
    deactivate ProjectRepo

    Svc -> UserRepo : findById(currentUserId)
    activate UserRepo
    UserRepo --> Svc : Optional<UserEntity>
    deactivate UserRepo

    Svc -> Publisher : publishInvitationAccepted(invitationAcceptedEvent)
    activate Publisher
    Publisher ->> MQ : publish(exchange="wpe.exchange",\nroutingKey="wpe.notification.invitation_accepted")
    Publisher --> Svc : void
    deactivate Publisher

    Svc --> Ctl : void
    Ctl --> Invitee : 200 OK (Map: success=true, message, invitationId)
  end
end

deactivate Svc
deactivate Ctl
@enduml
