' Nguồn: wpe-backend/src/main/java/com/pipeline/wpe/controller/ProjectInvitationController.java, wpe-backend/src/main/java/com/pipeline/wpe/service/ProjectInvitationService.java, wpe-backend/src/main/java/com/pipeline/wpe/service/InvitationExpiryJob.java, docs/specs/system-overview.md, docs/FRONTEND_BACKEND_INTEGRATION_MAP.md Cụm 3.3 & 3.4
' Sơ đồ Activity: Quy trình mời thành viên tham gia dự án (WPE)

@startuml activity-moi-thanh-vien
!pragma layout smetana
skinparam shadowing false

|Chủ dự án|
start
:Mở hộp thoại mời thành viên;
:Nhập định danh người dùng và chọn vai trò;
:Gửi yêu cầu mời tham gia;

|Hệ thống|
:Kiểm tra quyền hạn người gửi;
if (Người gửi là Chủ dự án?) then (không)
  :Báo lỗi 403 ACCESS_DENIED;
  stop
else (phải)
  :Tìm kiếm tài khoản người được mời;
  if (Người dùng tồn tại?) then (không)
    :Báo lỗi 404 RESOURCE_NOT_FOUND;
    stop
  else (có)
    if (Đã là thành viên dự án?) then (đúng)
      :Báo lỗi 400 BAD_REQUEST;
      stop
    else (chưa)
      if (Đã có lời mời PENDING?) then (đúng)
        if (Lời mời cũ đã quá hạn?) then (đúng)
          :Đóng lời mời cũ (lưu EXPIRED);
        else (chưa)
          :Báo lỗi 409 INVITATION_ALREADY_PENDING;
          stop
        endif
      else (chưa)
      endif
      :Tạo bản ghi lời mời PENDING với hạn 7 ngày;
      fork
        :Lưu thông báo cho người được mời;
      fork again
        :Bắn sự kiện InvitationCreatedEvent qua RabbitMQ;
      end fork
      |Chủ dự án|
      :Xem lời mời trong danh sách chờ;
      |Người được mời|
      :Nhận thông báo mời tham gia;
      :Mở hộp thoại xem chi tiết lời mời;
      if (Hành động phản hồi?) then (chấp nhận)
        :Xác nhận chấp nhận lời mời;
        |Hệ thống|
        if (Lời mời còn trong hạn 7 ngày?) then (hết hạn)
          :Lưu trạng thái EXPIRED;
          :Báo lỗi 409 INVITATION_EXPIRED;
          stop
        else (còn hạn)
          :Chuyển trạng thái sang ACCEPTED;
          :Thêm bản ghi thành viên mới;
          :Đánh dấu đã đọc thông báo;
          :Bắn sự kiện InvitationAcceptedEvent qua RabbitMQ;
          |Chủ dự án|
          :Nhận thông báo thành viên đã gia nhập;
          stop
        endif
      else if (Hành động phản hồi?) then (từ chối)
        :Xác nhận từ chối lời mời;
        |Hệ thống|
        if (Lời mời còn trong hạn 7 ngày?) then (hết hạn)
          :Lưu trạng thái EXPIRED;
          :Báo lỗi 409 INVITATION_EXPIRED;
          stop
        else (còn hạn)
          :Chuyển trạng thái sang REJECTED;
          :Đánh dấu đã đọc thông báo;
          stop
        endif
      else (không phản hồi)
        |Người được mời|
        :Bỏ qua lời mời;
        |Hệ thống|
        :Mỗi giờ: quét lời mời quá hạn;
        :Chuyển trạng thái sang EXPIRED;
        stop
      endif
    endif
  endif
endif

@enduml
