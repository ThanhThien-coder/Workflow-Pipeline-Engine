package "dto" {
  class TaskCompletedEvent <<record>> {
    taskId: Long
    projectId: Long
    taskCode: String
    completedByUserId: Long
    completedAt: Instant
  }
  class NotificationEvent <<record>> {
    recipientUserId: Long
    projectId: Long
    title: String
    message: String
    type: String
    targetUrl: String
    createdAt: Instant
  }
  class UpdateNodeStatusRequest <<record>> {
    status: String
    rejectReason: String
