' Service: xem chi tiết ở hình class-thuc-thi; ở đây chỉ hiện tên
class StateMachineService
class TaskOverdueScanner
class WorkflowEventConsumer
class ArtifactService

package "repository" {
  interface "JpaRepository<T, Long>" as JpaRepository <<Spring Data>> {
    +findById(id: Long): Optional<T>
    +save(entity: T): T
    +delete(entity: T): void
  }
  interface NodeRepository {
    +findByProjectIdAndAssignedUserIdAndStatusNotOrderByDueDateAsc(projectId: Long, assignedUserId: Long, status: NodeStatus): List<NodeEntity>
    +findByStatusAndDueDateBeforeAndIsOverdueFalse(status: NodeStatus, now: Instant): List<NodeEntity>
  }
  interface NodeDependencyRepository {
    +findByParentNodeId(parentNodeId: Long): List<NodeDependencyEntity>
    +findByChildNodeId(childNodeId: Long): List<NodeDependencyEntity>
  }
  interface ArtifactRepository {
    +findByProjectIdOrderByCreatedAtDesc(projectId: Long): List<ArtifactEntity>
    +findByProjectIdAndNodeIdOrderByCreatedAtDesc(projectId: Long, nodeId: Long): List<ArtifactEntity>
    +findByProjectIdAndIsInRepositoryTrueOrderByCreatedAtDesc(projectId: Long): List<ArtifactEntity>
  }
  interface NotificationRepository {
    +findByUserIdOrderByCreatedAtDesc(userId: Long): List<NotificationEntity>
    +countByUserIdAndIsReadFalse(userId: Long): long
  }
  interface ProjectMemberRepository {
    +findByProjectIdAndUserIdAndRemovedAtIsNull(projectId: Long, userId: Long): Optional<ProjectMemberEntity>
  }
  interface ProjectRepository

  NodeRepository --|> JpaRepository : <<bind>> T = NodeEntity
  NodeDependencyRepository --|> JpaRepository : <<bind>> T = NodeDependencyEntity
  ArtifactRepository --|> JpaRepository : <<bind>> T = ArtifactEntity
  NotificationRepository --|> JpaRepository : <<bind>> T = NotificationEntity
  ProjectMemberRepository --|> JpaRepository : <<bind>> T = ProjectMemberEntity
  ProjectRepository --|> JpaRepository : <<bind>> T = ProjectEntity
}

package "entity" {
  class NodeEntity {
    -id: Long
    -code: String
    -title: String
    -description: String
    -status: NodeStatus = LOCKED
    -joinPolicy: JoinPolicy = ALL_COMPLETED
    -rejectReason: String
    -dueDate: Instant
    -isOverdue: Boolean = false
    -estimatedHours: Integer = 8
    -startedAt: Instant
    -version: Long = 0 {@Version}
    -createdAt: Instant
    -updatedAt: Instant
  }
  class ArtifactEntity {
    -id: Long
    -name: String
    -type: ArtifactType
    -url: String
    -isInRepository: Boolean = false
    -isPublicForGuest: Boolean = true
    -createdAt: Instant
  }
  class NotificationEntity {
    -id: Long
    -title: String
    -message: String
    -linkUrl: String
    -isRead: Boolean = false
    -createdAt: Instant
  }
  class NodeDependencyEntity {
    -id: Long
  }
  class ProjectMemberEntity {
    -id: Long
    -role: ProjectRole
    -joinedAt: Instant
    -removedAt: Instant
