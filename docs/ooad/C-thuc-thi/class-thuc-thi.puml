package "Spring / Jakarta (thư viện)" {
  class TransactionSynchronizationManager <<Spring>> {
    +{static} isSynchronizationActive(): boolean
    +{static} registerSynchronization(synchronization: TransactionSynchronization): void
  }
  interface TransactionSynchronization <<Spring>> {
    +afterCompletion(status: int): void
  }
  class RabbitTemplate <<Spring AMQP>> {
    +convertAndSend(exchange: String, routingKey: String, object: Object): void
  }
  interface "ConstraintValidator<ValidArtifactUrl, String>" as ConstraintValidator <<Jakarta>> {
    +isValid(value: String, context: ConstraintValidatorContext): boolean
  }
}

' --- Controller dùng service (dependency) ---
NodeController ..> StateMachineService
NodeController ..> CurrentUserProvider : requireCurrentUserId()
NodeController ..> ProjectAuthorizationService : getMyTasks kiểm thành viên
RealtimeController ..> SseEmitterService
RealtimeController ..> CurrentUserProvider
ArtifactController ..> ArtifactService
ArtifactController ..> CurrentUserProvider

' --- Bean tiêm qua constructor (association, mỗi bean là singleton) ---
StateMachineService "1" --> "1" WorkflowEventPublisher : eventPublisher
StateMachineService "1" --> "1" SseEmitterService : sseEmitterService
WorkflowEventConsumer "1" --> "1" StateMachineService : stateMachineService
WorkflowEventConsumer "1" --> "1" SseEmitterService : sseEmitterService
InvitationEventConsumer "1" --> "1" SseEmitterService : sseEmitterService
TaskOverdueScanner "1" --> "1" WorkflowEventPublisher : eventPublisher
TaskOverdueScanner "1" --> "1" SseEmitterService : sseEmitterService
WorkflowEventPublisher "1" --> "1" RabbitTemplate : rabbitTemplate
ArtifactService "1" --> "1" ProjectAuthorizationService : projectAuthorizationService

' --- Dùng tạm ---
StateMachineService ..> ArtifactUrlValidator : isValid(url)
StateMachineService ..> TransactionSynchronizationManager
StateMachineService ..> TransactionSynchronization : <<create>> lớp vô danh
WorkflowEventPublisher ..> TransactionSynchronizationManager
WorkflowEventPublisher ..> TransactionSynchronization : <<create>> lớp vô danh
ArtifactUrlValidator ..|> ConstraintValidator

note bottom of WorkflowEventPublisher
  Mẫu Publish–Subscribe: publisher gửi lên exchange "wpe.workflow.exchange",
  RabbitMQ chia theo routing key vào queue; consumer (@RabbitListener)
  nhận mà không biết ai gửi.
end note

note bottom of SseEmitterService
  Mẫu Observer: mỗi tab trình duyệt đăng ký (subscribe) một SseEmitter;
  sendToUser báo cho mọi emitter của user. TransactionSynchronization
  cũng là Observer: Spring gọi lại afterCompletion khi transaction xong.
end note

@enduml

